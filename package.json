{
	"name": "omp-antigravity-cli",
	"version": "1.0.1",
	"description": "An unofficial OMP plugin that delegates tasks and slash commands to the Antigravity CLI (agy)",
	"license": "MIT",
	"type": "module",
	"main": "src/index.ts",
	"files": ["src", "assets", "!src/*.test.ts"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Attacktive/omp-antigravity-cli.git"
	},
	"keywords": ["omp", "oh-my-pi", "omp-plugin", "antigravity", "antigravity-cli", "agy"],
	"author": "Attacktive",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "bun test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@oh-my-pi/pi-coding-agent": "^18.1.6",
		"@types/bun": "^1.4.0",
		"eslint": "^10.9.1",
		"jiti": "^2.7.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0"
	},
	"omp": {
		"name": "Antigravity",
		"description": "Delegate tasks and slash commands to the Antigravity CLI (agy)",
		"extensions": ["src/index.ts"]
	}
}
